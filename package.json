{
  "name": "ky-poni",
  "version": "1.2.2",
  "description": "Game-aesthetic livestream chat overlay for OBS Studio",
  "main": "src/electron_main.js",
  "scripts": {
    "start": "electron .",
    "start:server": "node src/server.js",
    "build:linux": "electron-builder --linux AppImage",
    "build:win": "electron-builder --win portable",
    "build:all": "electron-builder --linux AppImage --win portable",
    "test": "node test/test_server.js && node test/test_anti_rto.js && node test/test_connectivity.js && node test/test_autoconnect.js && node test/test_persistence.js && node test/test_dashboard_boot.js && node test/test_windows_compat.js && node test/test_security_hardening.js && node test/test_security_regression.js && node test/test_overlay_settings.js && node test/test_config_broadcast.js",
    "test:overlay": "node test/test_overlay_settings.js",
    "test:broadcast": "node test/test_config_broadcast.js",
    "test:connectivity": "node test/test_connectivity.js",
    "test:persistence": "node test/test_persistence.js",
    "test:boot": "node test/test_dashboard_boot.js",
    "test:windows": "node test/test_windows_compat.js",
    "test:autoconnect": "node test/test_autoconnect.js"
  },
  "build": {
    "electronVersion": "44.9.3",
    "appId": "com.milkybrain.kyponi",
    "productName": "KY-Poni",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!src/config.json"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo",
      "executableName": "ky-poni",
      "artifactName": "${productName}-${version}.${ext}"
    },
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "${productName}-${version}.${ext}"
    }
  },
  "keywords": [
    "obs",
    "overlay",
    "livestream",
    "youtube",
    "persona5",
    "chat-box"
  ],
  "author": "Milky Brain (Fonzy)",
  "license": "MIT",
  "dependencies": {
    "ws": "^8.22.1",
    "youtube-chat": "^2.2.0"
  },
  "devDependencies": {
    "electron": "^44.9.3",
    "electron-builder": "^26.18.0"
  }
}
